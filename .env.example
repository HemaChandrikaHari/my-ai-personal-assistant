APP_ENV=development
DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant
JWT_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BLUETICKS_MCP_URL=https://api.blueticks.co/mcp
BLUETICKS_BEARER_TOKEN=
BLUETICKS_REDIRECT_URI=http://localhost:8000/api/v1/oauth/blueticks/callback
BLUETICKS_READ_ONLY_TOOLS=chats_read,scheduled_messages_read
BLUETICKS_SEND_TOOLS=
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_DEV_AUTH=true
NEXT_PUBLIC_DEV_USER=local-developer
ASSISTANT_API_URL=http://backend:8000
ASSISTANT_BACKEND_TOKEN=

# OAuth credentials: create OAuth apps in Google Cloud Console and Todoist App Management.
FRONTEND_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
TODOIST_REDIRECT_URI=http://localhost:8000/api/v1/oauth/todoist/callback
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
